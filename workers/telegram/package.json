{
  "name": "hustlai-telegram-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Telegram alert worker for HustleAI. Runs on Railway, independent of Lovable Cloud edge functions.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "railway:start": "npm run build && npm run start"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}