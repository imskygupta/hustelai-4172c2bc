# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Comma/space separated list of admin chat IDs
TELEGRAM_ADMIN_CHAT_IDS=11111111,22222222

# --- Supabase (service role, server-only) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role...

# --- Worker ---
PORT=8080
# Shared secret required on every inbound request (X-Worker-Secret)
WORKER_SHARED_SECRET=replace-with-long-random-string
# Dedupe window in ms (default 30s)
DEDUPE_WINDOW_MS=30000
NODE_ENV=production
# --- Ops worker (Phase B opt-in) ---
# Flip to "true" to start queue poller, cron, sweeper, heartbeat loops
# alongside the existing /send-alert HTTP server.
OPS_WORKER_ENABLED=false
OPS_WORKER_ID=

# --- Phase 1: workflow-runner loop (default OFF) ---
LOOP_WORKFLOW=false
# When true (default), the loop invokes the edge function when due work exists.
# Set to "false" for pure observe-only (peek + log, no invoke) during dual-run.
WORKFLOW_DUAL_RUN=true
WORKFLOW_CLAIM_LIMIT=10
POLL_IDLE_MIN_MS=5000
POLL_IDLE_MAX_MS=60000

# --- Phase 8: reconciliation loop (default OFF) ---
# Repairs continuity drift between workspace_artifacts and TG delivery.
# See docs/architecture/sprint-d-ownership.md
LOOP_RECONCILIATION=false
RECON_IDLE_MIN_MS=30000
RECON_IDLE_MAX_MS=300000
RECON_SCAN_LIMIT=25

# --- Sprint E Phase 6: lifecycle/retention sweep (default OFF) ---
# Soft-degrades expired workspace_artifacts continuity (active → expired).
# Telegram payloads are NEVER deleted by this loop.
LOOP_LIFECYCLE=false
LIFECYCLE_IDLE_MIN_MS=300000
LIFECYCLE_IDLE_MAX_MS=3600000
LIFECYCLE_BATCH=200

# --- Supervisor safeguards (apply to all supervised loops) ---
# Self-disable a loop after this many crashes within the rolling window.
LOOP_CRASH_BUDGET=10
LOOP_CRASH_WINDOW_MS=600000
# Flag a loop as `stale` if it hasn't reported a tick in this long.
LOOP_STALE_MS=300000
# Warn (and increment slow_ticks) when a single tick exceeds this duration.
LOOP_SLOW_TICK_MS=30000
# Flag queue starvation when depth > 0 hasn't drained in this long.
LOOP_STARVATION_MS=600000

# --- Per-DB scoped service-role keys (least-privilege) ---
# Configure only the DBs each future loop needs. Loops throw lazily on first
# use if their key is missing — the worker still boots.
BLOG_SUPABASE_URL=
BLOG_SUPABASE_SERVICE_ROLE_KEY=
AI_SUPABASE_URL=
AI_SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SUPABASE_URL=
ADMIN_SUPABASE_SERVICE_ROLE_KEY=
